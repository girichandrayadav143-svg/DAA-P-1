n = int(input("Enter number of vertices: "))

print("Enter the adjacency matrix (0 means no edge):")
graph = []

for i in range(n):
    row = list(map(int, input().split()))
    graph.append(row)

selected = [False] * n
selected[0] = True

edges = 0
total_cost = 0

print("\nEdges in Minimum Spanning Tree:")

while edges < n - 1:
    minimum = float('inf')
    x = -1
    y = -1

    for i in range(n):
        if selected[i]:
            for j in range(n):
                if not selected[j] and graph[i][j] != 0:
                    if graph[i][j] < minimum:
                        minimum = graph[i][j]
                        x = i
                        y = j

    if x == -1:
        print("Graph is disconnected!")
        break

    print(x, "-", y, ":", minimum)

    selected[y] = True
    total_cost += minimum
    edges += 1

if edges == n - 1:
    print("Total MST cost:", total_cost)
