def floyd_warshall(n, graph):
    INF = float('inf')

    
    dist = [row[:] for row in graph]

   
    for k in range(n):
        for i in range(n):
            for j in range(n):
                if dist[i][k] 
                    dist[i][j] = min(
                        dist[i][j],
                        dist[i][k] + dist[k][j]
                    )

    
    for i in range(n):
        if dist[i][i] < 0:
            print("Negative weight cycle detected!")
            return

   
    print("\nAll-Pairs Shortest Distance Matrix:")
    for i in range(n):
        for j in range(n):
            if dist[i][j] == INF:
                print("INF", end="\t")
            else:
                print(int(dist[i][j]), end="\t")
        print()



n = int(input("Enter number of vertices: "))

INF = float('inf')

graph = []

print("Enter adjacency matrix (use INF for no edge):")

for i in range(n):
    row = input().split()
    graph.append([
        INF if x.upper() == "INF" else int(x)
        for x in row
    ])

floyd_warshall(n, graph)
